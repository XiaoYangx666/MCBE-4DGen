{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/bedrock-types.ts",
    "../src/geometry-validator.ts",
    "../src/skin-pack-files.ts",
    "../tests/webapp-geometry.test.ts",
    "../tests/webapp-atlas.test.ts"
  ]
}
