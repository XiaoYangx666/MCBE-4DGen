    "../src/model-candidates.ts",
    "../src/model-orientation.ts",
    "../src/mtoon-materials.ts",
    "../src/pmx-materials.ts",
    "../src/pmx-metadata.ts",
    "../src/reduce-policy.ts",
    "../src/skin-pack-files.ts",
    "../src/source-sites.ts",
    "../src/tga.ts",
    "../src/texture-pixels.ts",
    "../src/vrm-humanoid.ts",
    "../web/shared/**/*.ts",
    "../web/shared/**/*.tsx",
    "../tests/webapp-geometry.test.ts",
    "../tests/webapp-model-candidates.test.ts",
    "../tests/webapp-extract.test.ts",
    "../tests/webapp-humanoid.test.ts",
    "../tests/webapp-atlas.test.ts",
    "../tests/webapp-model-zip.test.ts",
    "../tests/webapp-pmx.test.ts",
    "../tests/webapp-pose.test.ts",
    "../tests/webapp-materials.test.ts",
    "../tests/webapp-output-preview.test.ts",
    "../tests/webapp-preview-materials.test.ts",
    "../tests/webapp-progress.test.ts",
    "../tests/webapp-reduce.test.ts",
    "../tests/webapp-resources.test.ts",
    "../tests/webapp-pack-import.test.ts",
    "../tests/webapp-vrm-materials.test.ts"
  ]
}
