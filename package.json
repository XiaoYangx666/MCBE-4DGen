{
  "name": "bedrock-poly-skin-converter",
  "version": "0.0.1",
  "private": true,
  "description": "把 PMX/VRM/GLB/OBJ 等模型转换为 Minecraft Bedrock 4D 皮肤包，并提供本地工作台与可恢复的皮肤包管理。",
  "license": "GPL-3.0-only",
  "author": "XiaoYangx666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoYangx666/MCBE-4DGen.git"
  },
  "homepage": "https://github.com/XiaoYangx666/MCBE-4DGen#readme",
  "bugs": {
    "url": "https://github.com/XiaoYangx666/MCBE-4DGen/issues"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "skin-pack",
    "poly-mesh",
    "pmx",
    "vrm",
    "gltf",
    "electron"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p webapp/tsconfig.json",
    "test": "vitest run",
    "webapp:dev": "vite --config webapp/vite.config.ts",
    "webapp:build": "vite build --config webapp/vite.config.ts",
    "webapp:preview": "vite preview --config webapp/vite.config.ts",
    "check:webapp": "tsc --noEmit -p webapp/tsconfig.json",
    "test:workflow": "vitest run tests/pack-manager.test.ts tests/humanoid.test.ts tests/texture-optimizer.test.ts tests/rigid-mesh-reducer.test.ts tests/pmx-wasm.test.ts tests/bedrock-export.test.ts tests/geometry-validator.test.ts tests/prepare-model.test.ts tests/skin-pack.test.ts tests/preview.test.ts tests/web-preview.test.ts --testTimeout=30000",
    "probe": "node scripts/checks/probe.ts",
    "inspect": "node src/cli.ts inspect",
    "sample:fetch": "node scripts/samples/fetch-sample.ts",
    "sample:check": "node scripts/samples/check-sample.ts",
    "sample:prepare": "node scripts/samples/prepare-sample.ts",
    "sample:export": "node scripts/samples/export-sample.ts",
    "convert": "node src/cli.ts convert",
    "validate": "node src/cli.ts validate",
    "preview": "node src/cli.ts preview",
    "packs": "node src/pack-cli.ts",
    "binding:inspect": "node scripts/diagnostics/inspect-avatar-binding.ts",
    "binding:preview": "node scripts/diagnostics/preview-binding.ts",
    "workflow": "node scripts/workflow/workflow.ts",
    "dev": "node server/start.ts",
    "check:web": "tsc --noEmit -p tsconfig.web.json",
    "test:studio": "node scripts/checks/check-studio.ts",
    "test:node": "node scripts/checks/check-node.ts",
    "desktop": "node scripts/desktop/desktop.ts",
    "desktop:package": "node scripts/desktop/package-desktop.ts",
    "desktop:installer": "node scripts/desktop/package-installer.ts",
    "test:desktop": "node scripts/checks/check-desktop.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "gl-matrix": "3.4.4",
    "jszip": "3.10.2",
    "libassimp": "0.3.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "electron": "44.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "main": "desktop/main.cjs",
  "productName": "4DGen"
}
