{
  "name": "bedrock-poly-skin-converter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "probe": "bun run scripts/probe.ts",
    "inspect": "bun run src/cli.ts inspect",
    "sample:fetch": "bun run scripts/fetch-sample.ts",
    "sample:check": "bun run scripts/check-sample.ts",
    "sample:prepare": "bun run scripts/prepare-sample.ts",
    "sample:export": "bun run scripts/export-sample.ts",
    "convert": "bun run src/cli.ts convert",
    "validate": "bun run src/cli.ts validate",
    "preview": "bun run src/cli.ts preview"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "gl-matrix": "3.4.4",
    "jszip": "3.10.2",
    "libassimp": "0.3.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}

