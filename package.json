{
  "name": "bedrock-poly-skin-converter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:workflow": "bun test tests/pack-manager.test.ts tests/humanoid.test.ts tests/texture-optimizer.test.ts tests/rigid-mesh-reducer.test.ts tests/pmx-wasm.test.ts tests/bedrock-export.test.ts tests/geometry-validator.test.ts tests/prepare-model.test.ts tests/skin-pack.test.ts tests/preview.test.ts tests/web-preview.test.ts --timeout 30000",
    "probe": "bun run scripts/probe.ts",
    "inspect": "bun run src/cli.ts inspect",
    "sample:fetch": "bun run scripts/samples/fetch-sample.ts",
    "sample:check": "bun run scripts/samples/check-sample.ts",
    "sample:prepare": "bun run scripts/samples/prepare-sample.ts",
    "sample:export": "bun run scripts/samples/export-sample.ts",
    "convert": "bun run src/cli.ts convert",
    "validate": "bun run src/cli.ts validate",
    "preview": "bun run src/cli.ts preview",
    "packs": "bun run src/pack-cli.ts",
    "binding:inspect": "bun run scripts/diagnostics/inspect-avatar-binding.ts",
    "binding:preview": "bun run scripts/diagnostics/preview-binding.ts",
    "workflow": "bun run scripts/workflow.ts",
    "dev": "bun server/start.ts",
    "check:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "gl-matrix": "3.4.4",
    "jszip": "3.10.2",
    "libassimp": "0.3.0",
    "meshoptimizer": "1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
